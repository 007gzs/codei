    "@codei/codei-linux-arm64-musl": "0.0.12",
    "@codei/codei-darwin-x64": "0.0.12",
    "@codei/codei-darwin-arm64": "0.0.12",
    "@codei/codei-win32-x64": "0.0.12",
    "@codei/codei-win32-arm64": "0.0.12"
